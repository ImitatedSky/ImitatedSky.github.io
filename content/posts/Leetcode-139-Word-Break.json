        node </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> node.children[c]</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        node.is_word </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#D19A66\"> True</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    </span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">    def</span><span style=\"color:#61AFEF\"> search</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#E5C07B;font-style:italic\">self</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#D19A66;font-style:italic\">word</span><span style=\"color:#ABB2BF\">):</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        node </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#E5C07B\"> self</span><span style=\"color:#ABB2BF\">.root</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        for</span><span style=\"color:#ABB2BF\"> c </span><span style=\"color:#C678DD\">in</span><span style=\"color:#ABB2BF\"> word:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            if</span><span style=\"color:#ABB2BF\"> c </span><span style=\"color:#C678DD\">not</span><span style=\"color:#C678DD\"> in</span><span style=\"color:#ABB2BF\"> node.children:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                return</span><span style=\"color:#D19A66\"> False</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            node </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> node.children[c]</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        return</span><span style=\"color:#ABB2BF\"> node.is_word</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    </span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">class</spa