yle=\"color:#56B6C2\">==</span><span style=\"color:#D19A66\"> 2</span><span style=\"color:#ABB2BF\">: </span><span style=\"color:#C678DD\">return</span><span style=\"color:#56B6C2\"> max</span><span style=\"color:#ABB2BF\">(nums)</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        dp </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> [</span><span style=\"color:#D19A66\">0</span><span style=\"color:#ABB2BF\">]</span><span style=\"color:#56B6C2\">*len</span><span style=\"color:#ABB2BF\">(nums)</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        dp[</span><span style=\"color:#D19A66\">0</span><span style=\"color:#ABB2BF\">] </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> nums[</span><span style=\"color:#D19A66\">0</span><span style=\"color:#ABB2BF\">]</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        dp[</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\">] </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#56B6C2\"> max</span><span style=\"color:#ABB2BF\">(nums[</span><span style=\"color:#D19A66\">0</span><span style=\"color:#ABB2BF\">], nums[</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\">])</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        for</span><span style=\"color:#ABB2BF\"> i </span><span style=\"color:#C678DD\">in</span><span style=\"color:#56B6C2\"> range</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#D19A66\">2</span><span style=\"color:#ABB2BF\">,</span><span style=\"color:#56B6C2\">len</span><span style=\"color:#ABB2BF\">(nums)):</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            dp[i] </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#56B6C2\"> max</span><span style=\"color:#ABB2BF\">(dp[i</span><span style=\"color:#56B6C2\">-</