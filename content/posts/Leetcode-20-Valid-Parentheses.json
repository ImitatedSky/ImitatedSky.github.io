379\"> ')'</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                return</span><span style=\"color:#D19A66\"> True</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            elif</span><span style=\"color:#ABB2BF\"> s1 </span><span style=\"color:#56B6C2\">==</span><span style=\"color:#98C379\"> '{'</span><span style=\"color:#C678DD\"> and</span><span style=\"color:#ABB2BF\"> s2 </span><span style=\"color:#56B6C2\">==</span><span style=\"color:#98C379\"> '}'</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                return</span><span style=\"color:#D19A66\"> True</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            elif</span><span style=\"color:#ABB2BF\"> s1 </span><span style=\"color:#56B6C2\">==</span><span style=\"color:#98C379\"> '['</span><span style=\"color:#C678DD\"> and</span><span style=\"color:#ABB2BF\"> s2 </span><span style=\"color:#56B6C2\">==</span><span style=\"color:#98C379\"> ']'</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                return</span><span style=\"color:#D19A66\"> True</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            else</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                return</span><span style=\"color:#D19A66\"> False</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        for</span><span style=\"color:#ABB2BF\"> i </span><span style=\"color:#C678DD\">in</span><span style=\"color:#56B6C2\"> range</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#56B6C2\">len</span><span style=\"color:#ABB2BF\">(s)):</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            brackets.</span><span style=\"color:#61AFEF\">append</span><span style=\"color:#ABB2BF\">(s[i])</span></span>\n<span data-line=\"\"><span style=\"color:#61AFEF\">            check</span><span style=\"color:#ABB2BF\">(brackets)</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        </span></span>\n<span data-line=\"\"><span style=\"color:#7F848E;font-style:italic\">        # 空的返回 true</span></span>\n<span data-line=\"\"><span style=\"color:#7F848E;font-style:italic\">        # print(brackets)</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        return</span><span style=\"color:#C678DD\"> not</span><span style=\"color:#ABB2BF\"> brackets</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        </span></span></code></pre></figure>"}