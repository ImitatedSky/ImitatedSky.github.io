"color:#C678DD\">            if</span><span style=\"color:#ABB2BF\"> node.children[char].is_word:</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">                res.</span><span style=\"color:#61AFEF\">append</span><span style=\"color:#ABB2BF\">(path </span><span style=\"color:#56B6C2\">+</span><span style=\"color:#ABB2BF\"> char)</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">                node.children[char].is_word </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#D19A66\"> False</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            board[r][c] </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#98C379\"> \"#\"</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#61AFEF\">            dfs</span><span style=\"color:#ABB2BF\">( r</span><span style=\"color:#56B6C2\">+</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\"> , c , node.children[char] , path </span><span style=\"color:#56B6C2\">+</span><span style=\"color:#ABB2BF\"> char)</span></span>\n<span data-line=\"\"><span style=\"color:#61AFEF\">            dfs</span><span style=\"color:#ABB2BF\">( r</span><span style=\"color:#56B6C2\">-</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\"> , c , node.children[char] , path </span><span style=\"color:#56B6C2\">+</span><span style=\"color:#ABB2BF\"> char)</span></span>\n<span data-line=\"\"><span style=\"color:#61AFEF\">            dfs</span><span style=\"color:#ABB2BF\">( r , c</span><span style=\"color:#56B6C2\">+</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\"> , node.children[char] , path </span><span style=\"color:#56B6C2\">+</span><span style=\"color:#ABB2BF\"> char)</span></span>\n<span data-line=\"\"><span style=\"color:#61AFEF\">            dfs</span><span style=\"color:#ABB2BF\">( r , c</span><span style=\"color:#56B6C2\">-</span><s