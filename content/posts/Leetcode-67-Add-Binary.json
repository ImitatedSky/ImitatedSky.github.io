e=\"color:#ABB2BF\">(a[i])</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">          i </span><span style=\"color:#56B6C2\">-=</span><span style=\"color:#D19A66\"> 1</span><span style=\"color:#ABB2BF\"> </span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        if</span><span style=\"color:#ABB2BF\"> j </span><span style=\"color:#56B6C2\">>=</span><span style=\"color:#D19A66\"> 0</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">          total </span><span style=\"color:#56B6C2\">+=</span><span style=\"color:#56B6C2\"> int</span><span style=\"color:#ABB2BF\">(b[j])</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">          j </span><span style=\"color:#56B6C2\">-=</span><span style=\"color:#D19A66\"> 1</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        s </span><span style=\"color:#56B6C2\">+=</span><span style=\"color:#ABB2BF\"> (</span><span style=\"color:#56B6C2\">str</span><span style=\"color:#ABB2BF\">(total </span><span style=\"color:#56B6C2\">%</span><span style=\"color:#D19A66\"> 2</span><span style=\"color:#ABB2BF\">))</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        carry </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> total </span><span style=\"color:#56B6C2\">//</span><span style=\"color:#D19A66\"> 2</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        </span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">      return</span><span style=\"color:#ABB2BF\"> s[::</span><span style=\"color:#56B6C2\">-</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\">]</span></span></code></pre></figure>\n<h2 id=\"偷吃步\"><a href=\"#偷吃步\"><span data-rehype-pretty-code-figure=\"\"><code data-language=\"text\" data-theme=\"one-dark-pro\" style=\"background-color:#282c34;color:#abb2bf