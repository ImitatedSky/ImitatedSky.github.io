 data-line=\"\"><span style=\"color:#7F848E;font-style:italic\">      # 不會動到原先的a,b</span></span>\n<span data-line=\"\"><span style=\"color:#7F848E;font-style:italic\">      # i  j 為處理的位置</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">      while</span><span style=\"color:#ABB2BF\"> i </span><span style=\"color:#56B6C2\">>=</span><span style=\"color:#D19A66\"> 0</span><span style=\"color:#C678DD\"> or</span><span style=\"color:#ABB2BF\"> j </span><span style=\"color:#56B6C2\">>=</span><span style=\"color:#D19A66\"> 0</span><span style=\"color:#C678DD\"> or</span><span style=\"color:#ABB2BF\"> carry:</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        total </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> carry</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        if</span><span style=\"color:#ABB2BF\"> i </span><span style=\"color:#56B6C2\">>=</span><span style=\"color:#D19A66\"> 0</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">          total </span><span style=\"color:#56B6C2\">+=</span><span style=\"color:#56B6C2\"> int</span><span style=\"color:#ABB2BF\">(a[i])</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">          i </span><span style=\"color:#56B6C2\">-=</span><span style=\"color:#D19A66\"> 1</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        if</span><span style=\"color:#ABB2BF\"> j </span><span style=\"color:#56B6C2\">>=</span><span style=\"color:#D19A66\"> 0</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">          total </span><span style=\"color:#56B6C2\">+=</span><span style=\"color:#56B6C2\"> int</span><span style=\"color:#ABB2BF\">(b[j])</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">          j </span><span style=\"color:#56B6C2\">-=</span><span style=\"color:#D19A66\"> 1</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        s.</span><span style=\"color:#61AFEF\">append</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#56B6C2\">str</span><span style=\"color:#ABB2BF\">(total </span><span style=\"color:#56B6C2\">%</span><span style=\"color:#D19A66\"> 2</span><span style=\"color:#ABB2BF\">))</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        carry </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> total </span><span style=\"color:#56B6C2\">//</span><span style=\"color:#D19A66\"> 2</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        </span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">      return</span><span style=\"color:#98C379\"> ''</span><span style=\"color:#ABB2BF\">.</span><span style=\"color:#61AFEF\">join</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#56B6C2\">reversed</span><span style=\"color:#ABB2BF\">(s))</span></span></code></pre></figure>\n<p>稍做修改</p>\n<figure data-rehype-pretty-code-figure=\"\"><pre style=\"background-color:#282c34;color:#abb2bf\" tabindex=\"0\" data-language=\"python\" data-theme=\"one-dark-pro\"><code data-language=\"python\" data-theme=\"one-dark-pro\" style=\"display: grid;\"><span data-line=\"\"><span style=\"color:#C678DD\">class</span><span style=\"color:#E5C07B\"> Solution</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">    def</span><span style=\"color:#61AFEF\"> addBinary</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#E5C07B;font-style:italic\">self</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#D19A66;font-style:italic\">a</span><span style=\"color:#ABB2BF\">: </span><span style=\"color:#56B6C2\">str</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#D19A66;font-style:italic\">b</span><span style=\"color:#ABB2BF\">: </span><span style=\"color:#56B6C2\">str</span><span style=