><span style=\"color:#D19A66\">True</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"g\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"at\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"at\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"g\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"gr\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"eat\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">True</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"eat\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"gr\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">True</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"rg\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"eat\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">True</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"eat\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"rg\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">True</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"g\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"rge\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"rge\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"g\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"gr\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"ge\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"ge\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"gr\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"g\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"eat\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"eat\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"g\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"gr\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"reat\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"reat\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"gr\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">False</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"rg\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"eat\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">True</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    (</span><span style=\"color:#98C379\">\"eat\"</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#98C379\">\"rg\"</span><span style=\"color:#ABB2BF\">): </span><span style=\"color:#D19A66\">True</span><span style=\"color:#ABB2BF\">,</span></span>\n<span data-line=\"\"><span style=\"color:#D19A66\">    ...</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">}</span></span></code></pre></figure>\n<h2 id=\"目前看到的最佳解之一\"><a href=\"#目前看到的最佳解之一\"><span data-rehype-pretty-code-figure=\"\"><code data-language=\"text\" data-theme=\"one-dark-pro\" style=\"background-color:#282c34;color:#abb2bf\"><span data-line=\"\"><span>目前看到的最佳解之一</span></span></code></span></a></h2>\n<p>使用的Memory更少</p>\n<figure data-rehype-pretty-code-figure=\"\"><pre style=\"background-color:#282c34;color:#abb2bf\" tabindex=\"0\" data-language=\"python\" data-theme=\"one-dark-pro\"><code data-language=\"python\" data-theme=\"one-dark-pro\" style=\"display: grid;\"><span data-line=\"\"><span style=\"color:#C678DD\">class</span><span style=\"color:#E5C07B\"> Solution</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">    def</span><span style=\"color:#61AFEF\"> isScramble</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#E5C07B;font-style:italic\">self</span><span style=\"color:#ABB2BF\">,</span><span style=\"color:#D19A66;font-style:italic\">s1</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#D19A66;font-style:italic\">s2</span><span style=\"color:#ABB2BF\">):</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        m </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\">{}</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        def</span><span style=\"color:#61AFEF\"> func</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#D19A66;font-style:italic\">s1</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#D19A66;font-style:italic\">s2</span><span style=\"color:#ABB2BF\">):</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            if</span><span style=\"color:#ABB2BF\"> (s1, s2) </span><span style=\"color:#C678DD\">in</span><span style=\"color:#ABB2BF\"> m:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                return</span><span style=\"color:#ABB2BF\"> m[(s1, s2)]</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            if</span><span style=\"color:#C678DD\"> not</span><span style=\"color:#56B6C2\"> sorted</span><span style=\"color:#ABB2BF\">(s1) </span><span style=\"color:#56B6C2\">==</span><span style=\"color:#56B6C2\"> sorted</span><span style=\"color:#ABB2BF\">(s2):</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                return</span><span style=\"color:#D19A66\"> False</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            if</span><span style=\"color:#56B6C2\"> len</span><span style=\"color:#ABB2BF\">(s1) </span><span style=\"color:#56B6C2\">==</span><span style=\"color:#D19A66\"> 1</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                return</span><span style=\"color:#D19A66\"> True</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            </span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            for</span><span style=\"color:#ABB2BF\"> i </span><span style=\"color:#C678DD\">in</span><span style=\"color:#56B6C2\"> range</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\">, </span><span style=\"color:#56B6C2\">len</span><span style=\"color:#ABB2BF\">(s1)):</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                if</span><span style=\"color:#61AFEF\"> func</span><span style=\"color:#ABB2BF\">(s1[:i], s2[</span><span style=\"color:#56B6C2\">-</span><span style=\"color:#ABB2BF\">i:]) </span><span style=\"color:#C678DD\">and</span><span style=\"color:#61AFEF\"> func</span><span style=\"color:#ABB2BF\">(s1[i:], s2[:</span><span style=\"color:#56B6C2\">-</span><span style=\"color:#ABB2BF\">i]) </span><span style=\"color:#C678DD\">or</span><span style=\"color:#61AFEF\"> func</span><span style=\"color:#ABB2BF\">(s1[:i], s2[:i]) </span><span style=\"color:#C678DD\">and</span><span style=\"color:#61AFEF\"> func</span><span style=\"color:#ABB2BF\">(s1[i:], s2[i:]):</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">                    m[(s1, s2)] </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#D19A66\"> True</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">                    return</span><span style=\"color:#D19A66\"> True</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            m[(s1, s2)] </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#D19A66\"> False</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">            return</span><span style=\"color:#D19A66\"> False</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        return</span><span style=\"color:#61AFEF\"> func</span><span style=\"color:#ABB2BF\">(s1, s2)</span></span></code></pre></figure>"}