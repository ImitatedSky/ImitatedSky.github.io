"color:#ABB2BF\">            items[k]</span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\">right[j]</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            j </span><span style=\"color:#56B6C2\">+=</span><span style=\"color:#D19A66\"> 1</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            k </span><span style=\"color:#56B6C2\">+=</span><span style=\"color:#D19A66\"> 1</span></span></code></pre></figure>\n<h2 id=\"o2n指數時間\"><a href=\"#o2n指數時間\">O(2^n)：指數時間</a></h2>\n<figure data-rehype-pretty-code-figure=\"\"><pre style=\"background-color:#282c34;color:#abb2bf\" tabindex=\"0\" data-language=\"python\" data-theme=\"one-dark-pro\"><code data-language=\"python\" data-theme=\"one-dark-pro\" style=\"display: grid;\"><span data-line=\"\"><span style=\"color:#C678DD\">def</span><span style=\"color:#61AFEF\"> exponential_algo</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#D19A66;font-style:italic\">items</span><span style=\"color:#ABB2BF\">):</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">    if</span><span style=\"color:#56B6C2\"> len</span><span style=\"color:#ABB2BF\">(items)</span><span style=\"color:#56B6C2\">==</span><span style=\"color:#D19A66\">0</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">        return</span><span style=\"color:#ABB2BF\"> [[]]</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    smaller </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#61AFEF\"> exponential_algo</span><span style=\"color:#ABB2BF\">(items[:</span><span style=\"color:#56B6C2\">-</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\">])</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">    extra </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> items[</span><span style=\"color:#56B6C2\">-</span><span style=\"color:#D19A66\">1</spa