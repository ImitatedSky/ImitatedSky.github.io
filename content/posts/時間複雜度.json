span style=\"color:#56B6C2\">-</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\">]</span><span style=\"color:#56B6C2\">></span><span style=\"color:#ABB2BF\">current_value:</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            items[position]</span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\">items[position</span><span style=\"color:#56B6C2\">-</span><span style=\"color:#D19A66\">1</span><span style=\"color:#ABB2BF\">]</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">            position </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\"> position</span><span style=\"color:#56B6C2\">-</span><span style=\"color:#D19A66\">1</span></span>\n<span data-line=\"\"> </span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        items[position]</span><span style=\"color:#56B6C2\">=</span><span style=\"color:#ABB2BF\">current_value</span></span></code></pre></figure>\n<h2 id=\"onlogn線性對數時間\"><a href=\"#onlogn線性對數時間\">O(nlogn)：線性對數時間</a></h2>\n<figure data-rehype-pretty-code-figure=\"\"><pre style=\"background-color:#282c34;color:#abb2bf\" tabindex=\"0\" data-language=\"python\" data-theme=\"one-dark-pro\"><code data-language=\"python\" data-theme=\"one-dark-pro\" style=\"display: grid;\"><span data-line=\"\"><span style=\"color:#C678DD\">def</span><span style=\"color:#61AFEF\"> linearithmic_algo</span><span style=\"color:#ABB2BF\">(</span><span style=\"color:#D19A66;font-style:italic\">items</span><span style=\"color:#ABB2BF\">):</span></span>\n<span data-line=\"\"><span style=\"color:#C678DD\">    if</span><span style=\"color:#56B6C2\"> len</span><span style=\"color:#ABB2BF\">(items) </span><span style=\"color:#56B6C2\">></span><span style=\"color:#D19A66\"> 1</span><span style=\"color:#ABB2BF\">:</span></span>\n<span data-line=\"\"><span style=\"color:#ABB2BF\">        mid </span><span style=\"color:#56B6C2\">=</span><span style=\"color:#56B6C2\"> len</span><s